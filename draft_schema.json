{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "equipment",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "equipment": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "intent_id",
    "object_id",
    "expected_version",
    "source_id",
    "source_revision",
    "fields"
  ]
}
