{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "current_support",
        "historical_analysis"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "document_id",
    "purpose"
  ]
}
